# =============================================================================
# AnonymousXchange Backend – Environment Variables
# Copy to .env and fill in real values. Never commit .env
# =============================================================================

NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# --- Database (PostgreSQL) ---
# Local (docker compose): postgresql://postgres:password@localhost:5432/anonymousxchange?schema=public
# Production (Supabase / Render / Neon): paste the full connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# --- Redis (optional but recommended for rate cache / sessions) ---
REDIS_URL=redis://localhost:6379

# --- JWT (generate long random strings, e.g. openssl rand -hex 64) ---
JWT_ACCESS_SECRET=change-this-to-a-very-long-and-secure-random-string-at-least-64-chars
JWT_REFRESH_SECRET=change-this-to-another-very-long-and-secure-random-string-at-least-64-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- OpenAI (enables real LLM chat; leave empty for rule-based fallback) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Email (optional – support tickets + status notifications) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@anonymousxchange.com
SUPPORT_EMAIL=support@yourdomain.com

# --- Telegram Bot ---
# 1. Create bot via @BotFather → get token
# 2. Set webhook: POST https://api.telegram.org/bot<TOKEN>/setWebhook
#    body: { "url": "https://YOUR_API_HOST/api/webhooks/telegram" }
TELEGRAM_BOT_TOKEN=

# --- WhatsApp Cloud API (Meta) ---
# 1. Create app in Meta Developers → WhatsApp → get Phone Number ID + token
# 2. Webhook URL: https://YOUR_API_HOST/api/webhooks/whatsapp
# 3. Verify token must match WHATSAPP_VERIFY_TOKEN
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=anonymousxchange_verify

# --- Rates ---
# CoinGecko is used by default (no key required for basic endpoints).
# Optional: COINGECKO_API_KEY= for higher rate limits
# USD_TO_NGN override (default ~1585 in code)
# USD_TO_NGN=1585
